landscape":{"url":"https://beehiiv-images-production.s3.amazonaws.com/uploads/user/profile_picture/f296a348-b27c-4e82-ae84-fce2e49bff12/landscape_pau_headshot_1.png"}},"bio":"𝘊𝘔𝘎𝘙/𝘛𝘦𝘭𝘭𝘶𝘴 𝘊𝘰𝘰𝘱𝘦𝘳𝘢𝘵𝘪𝘷𝘦","twitter_handle":"kl0ren","facebook_url":null,"instagram_url":null,"linkedin_url":null,"tiktok_url":null,"youtube_url":null,"discord_url":null,"bluesky_url":null}],"content_tags":[{"id":"6e4f03e2-5fcc-4c76-9eea-e936de5db272","display":"Boletín Semanal","slug":"boletin-semanal"},{"id":"89c8fef5-1da9-4d08-b488-2fc2c71796bf","display":"Educación","slug":"educacion"}],"created_at":"2025-06-02T19:04:00Z","updated_at":"2025-06-02T19:11:36Z","html":null,"hide_premium_post":false,"contains_subscriber_break":false,"is_accessible_for_free":true,"paywall_shown":false,"metered_usage_shown":false,"metered_viewed_count":null,"force_premium":false,"enforce_paywall_breaks":true,"display_thumbnail_on_web":true,"display_title_on_web":true,"display_subtitle_on_web":true,"author_urls":{"f296a348-b27c-4e82-ae84-fce2e49bff12":"https://blog.telluscoop.com/authors/pau-koh"},"custom_structured_data":null},"body":"<div class=\"_10pdwo80 dream-post-content-doc\"><div id=\"qu-tan-segura-es-la-blockchain\" class=\"hynlcx0\"><h3 class=\"hynlcx1 hynlcx4\" translations=\"[object Object]\"><span class=\"hxnnnr0\">¿Qué tan segura es la blockchain?</span></h3></div><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\"><span class=\"hxnnnr0\">La </span><span class=\"hxnnnr0\"><strong>blockchain</strong></span><span class=\"hxnnnr0\"> es una tecnología que permite llevar un registro digital de operaciones (como envíos de dinero o intercambio de datos) sin necesidad de intermediarios. Lo interesante es cómo funciona:</span></p></div><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\"><span class=\"hxnnnr0\">🔒 Cada bloque contiene información cifrada y está conectado al anterior.</span><br><span class=\"dl6s8g0 hxnnnr0\">🧾</span><span class=\"hxnnnr0\"> Una vez que una transacción se registra, no puede ser modificada.</span><br><span class=\"dl6s8g0 hxnnnr0\">🌐</span><span class=\"hxnnnr0\"> Este registro no está guardado en un solo lugar, sino </span><span class=\"hxnnnr0\"><strong>distribuido entre miles de computadores</strong></span><span class=\"hxnnnr0\"> alrededor del mundo.</span></p></div><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\"><span class=\"hxnnnr0\">En palabras simples: es </span><span class=\"hxnnnr0\"><strong>transparente, resistente a manipulaciones y más segura</strong></span><span class=\"hxnnnr0\"> que muchos sistemas tradicionales.</span></p></div><div data-generic-embed-container=\"true\" class=\"_8dv9ja0\"><a href=\"https://telluscoop.org/\" target=\"_blank\"><div class=\"_8dv9ja2\" style=\"--generic-embed-image-width:40%\"><div data-generic-embed-layout=\"true\" class=\"border-collapse w-full flex sm:flex-row flex-col-reverse\"><div class=\"_8dv9ja1\"><div data-generic-embed-title=\"true\" class=\"rq7pc90\"><p class=\"rq7pc91\"><span class=\"hxnnnr0\">Tellus Cooperative | La Cooperativa de LATAM</span></p></div><div data-generic-embed-description=\"true\" class=\"_1uh4x2v0\"><p class=\"_1uh4x2v2\"><span class=\"hxnnnr0\">Únete a Tellus Cooperative, la cooperativa de Latinoamérica impulsando el desarrollo económico y social a través de la tecnología blockchain y criptomonedas.</span></p></div><div data-generic-embed-host=\"true\" class=\"efatai0\"><p class=\"efatai1\"><span class=\"hxnnnr0\">telluscoop.org</span></p></div></div><div data-generic-embed-image-wrapper=\"true\" data-generic-embed-image-right=\"true\" class=\"w-full mb-[20px] sm:mb-0 sm:ml-[20px] sm:w-[var(--generic-embed-image-width)] sm:basis-[var(--generic-embed-image-width)] flex\" style=\"align-self:center\"><img src=\"https://opengraph.b-cdn.net/production/images/fe62c80e-07d7-459f-b130-779d459beee4.png?token=K8ydK9R4kl58d3UGs1BBUFTY3y4Z4OmMdF4YkioJ03g&amp;height=630&amp;width=1200&amp;expires=33284490305\" class=\"w-full h-auto object-cover\" alt=\"\"></div></div></div></a></div><div class=\"_7pt7ks0\"><div class=\"_7pt7ks1\"></div></div><div id=\"y-por-qu-usamos-stellar\" class=\"hynlcx0\"><h3 class=\"hynlcx1 hynlcx4\" translations=\"[object Object]\"><span class=\"hxnnnr0\">¿Y por qué usamos Stellar?</span></h3></div><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\"><span class=\"hxnnnr0\">Hay muchas blockchains hoy en día, pero </span><span class=\"hxnnnr0\"><strong>Stellar</strong></span><span class=\"hxnnnr0\"> es especial por varias razones:</span></p></div><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\"><span class=\"dl6s8g0 hxnnnr0\">💸</span><span class=\"hxnnnr0\"> Está diseñada específicamente para pagos y transferencias rápidas, seguras y a muy bajo costo.</span><br><span class=\"dl6s8g0 hxnnnr0\">🪙</span><span class=\"hxnnnr0\"> Permite usar tanto criptomonedas como monedas tradicionales (como pesos o dólares digitales).</span><br><span class=\"dl6s8g0 hxnnnr0\">🔗</span><span class=\"hxnnnr0\"> Las comisiones por transacción son bajísimas: estamos hablando de fracciones de centavo.</span><br><span class=\"hxnnnr0\">🌍 Tiene una comunidad fuerte enfocada en la </span><span class=\"hxnnnr0\"><strong>inclusión financiera global</strong></span><span class=\"hxnnnr0\">.</span></p></div><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\"><span class=\"hxnnnr0\">Esto la convierte en una herramienta ideal para quienes están comenzando y quieren aprender con una red </span><span class=\"hxnnnr0\"><strong>eficiente, ética y amigable</strong></span><span class=\"hxnnnr0\"> con desarrolladores y estudiantes.w</span></p></div><div data-generic-embed-container=\"true\" class=\"_8dv9ja0\"><a href=\"https://stellar.org/\" target=\"_blank\"><div class=\"_8dv9ja2\" style=\"--generic-embed-image-width:40%\"><div data-generic-embed-layout=\"true\" class=\"border-collapse w-full flex sm:flex-row flex-col-reverse\"><div class=\"_8dv9ja1\"><div data-generic-embed-title=\"true\" class=\"rq7pc90\"><p class=\"rq7pc91\"><span class=\"hxnnnr0\">Stellar | Blockchain Network for Smart Contracts, DeFi, Payments &amp; Asset Tokenization</span></p></div><div data-generic-embed-description=\"true\" class=\"_1uh4x2v0\"><p class=\"_1uh4x2v2\"><span class=\"hxnnnr0\">Stellar Network: Discover an open-source blockchain platform equipped for DeFi with a secure smart contract platform, fast and affordable payments and enterprise-grade asset tokenization. Join our vibrant ecosystem of developers, entrepreneurs, and enterprises to pioneer the future of blockchain technology</span></p></div><div data-generic-embed-host=\"true\" class=\"efatai0\"><p class=\"efatai1\"><span class=\"hxnnnr0\">stellar.org</span></p></div></div><div data-generic-embed-image-wrapper=\"true\" data-generic-embed-image-right=\"true\" class=\"w-full mb-[20px] sm:mb-0 sm:ml-[20px] sm:w-[var(--generic-embed-image-width)] sm:basis-[var(--generic-embed-image-width)] flex\" style=\"align-self:center\"><img src=\"https://cdn.sanity.io/images/e2r40yh6/production-i18n/99d61fd48d3faa071cb72003fc7aa33847faf457-3840x2160.png?rect=0,72,3840,2016&amp;w=1200&amp;h=630\" class=\"w-full h-auto object-cover\" alt=\"\"></div></div></div></a></div><div class=\"_7pt7ks0\"><div class=\"_7pt7ks1\"></div></div><div id=\"formacin-comunidad-y-oportunidades\" class=\"hynlcx0\"><h3 class=\"hynlcx1 hynlcx4\" translations=\"[object Object]\"><span class=\"hxnnnr0\">Formación, comunidad y oportunidades</span></h3></div><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\"><span class=\"hxnnnr0\">En Nuestra Cooperaetiva trabajamos con Stellar no solo por su tecnología, sino también por su enfoque educativo. Durante nuestros eventos enseñamos:</span></p></div><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\"><span class=\"dl6s8g0 hxnnnr0\">✅</span><span class=\"hxnnnr0\"> Qué es blockchain y cómo funciona</span><br><span class=\"dl6s8g0 hxnnnr0\">✅</span><span class=\"hxnnnr0\"> Cómo recibir becas y acceder a cursos gratuitos</span><br><span class=\"dl6s8g0 hxnnnr0\">✅</span><span class=\"hxnnnr0\"> Cómo postular al Programa de Embajadores de Stellar</span><br><span class=\"dl6s8g0 hxnnnr0\">✅</span><span class=\"hxnnnr0\"> Cómo comenzar a construir o trabajar en Web3 desde Latinoamérica</span></p></div><div class=\"_7pt7ks0\"><div class=\"_7pt7ks1\"></div></div><div id=\"quieres-que-visitemos-tu-universida\" class=\"hynlcx0\"><h3 class=\"hynlcx1 hynlcx4\" translations=\"[object Object]\"><span class=\"hxnnnr0\">¿Quieres que visitemos tu universidad?</span></h3></div><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\"><span class=\"hxnnnr0\">Si te gustaría que llevemos los Coffee Breaks a tu comunidad o institución, escríbenos. Nos encanta compartir conocimiento, resolver dudas y abrir nuevas oportunidades junto a quienes están recién comenzando.</span></p></div><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\"><span class=\"dl6s8g0 hxnnnr0\">📩</span><span class=\"hxnnnr0\"> Contáctanos en </span><span class=\"hxnnnr0\"><a href=\"hola@telluscoop.org\" target=\"_blank\" rel=\"\" class=\"_3k8pkd0\"><span class=\"__cf_email__\" data-cfemail=\"5a3235363b1a2e3f36362f293935352a7435283d\">[email&nbsp;protected]</span></a></span><br><span class=\"dl6s8g0 hxnnnr0\">🌐</span><span class=\"hxnnnr0\"> Y revisa nuestras próximas fechas en: </span><span class=\"hxnnnr0\"><a href=\"https://lu.ma/telluscoop\" target=\"_blank\" rel=\"\" class=\"_3k8pkd0\">https://lu.ma/telluscoop</a></span></p></div><div data-generic-embed-container=\"true\" class=\"_8dv9ja0\"><a href=\"https://discord.gg/2SHteza5dJ\" target=\"_blank\"><div class=\"_8dv9ja2\" style=\"--generic-embed-image-width:40%\"><div data-generic-embed-layout=\"true\" class=\"border-collapse w-full flex sm:flex-row flex-col-reverse\"><div class=\"_8dv9ja1\"><div data-generic-embed-title=\"tr