v>","publication":{"name":"Tellus Cooperative","description":"La Cooperativa Blockchain de LatAm","url":"https://blog.telluscoop.com/","twitter_url":"https://x.com/telluscoop","instagram_url":"https://instagram.com/telluscoop","linkedin_url":"https://linkedin.com/company/Tellus-Cooperative","youtube_url":"https://youtube.com/@telluscoop","discord_url":"https://discord.gg/V4eSGWA3PK"}}