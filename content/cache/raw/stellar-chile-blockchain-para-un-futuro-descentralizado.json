andscape":{"url":"https://beehiiv-images-production.s3.amazonaws.com/static_assets/gradient_avatar_4.png"}},"bio":null,"twitter_handle":"@CriptoEcosystem","facebook_url":null,"instagram_url":null,"linkedin_url":null,"tiktok_url":null,"youtube_url":null,"discord_url":null,"bluesky_url":null}],"content_tags":[],"created_at":"2024-09-24T16:36:46Z","updated_at":"2025-04-14T17:44:15Z","html":null,"hide_premium_post":false,"contains_subscriber_break":false,"is_accessible_for_free":true,"paywall_shown":false,"metered_usage_shown":false,"metered_viewed_count":null,"force_premium":false,"enforce_paywall_breaks":true,"display_thumbnail_on_web":false,"display_title_on_web":true,"display_subtitle_on_web":true,"author_urls":{"1f86722b-dab0-48ce-8e5a-78ea58e29ef4":"https://blog.telluscoop.com/authors/jenny"},"custom_structured_data":null},"body":"<div class=\"_10pdwo80 dream-post-content-doc\"><div class=\"dream-post-content-imageBlock _2fealp0\" style=\"--caption-alignment:center\"><div class=\"_2fealp1\"><picture><source media=\"(max-width: 360px) and (min-resolution: 2dppx)\" srcset=\"https://miro.medium.com/v2/resize:fit:700/1*cnSPkEyZFbC5vV4qgEiV8g.png 2x\"><source media=\"(max-width: 360px)\" srcset=\"https://miro.medium.com/v2/resize:fit:700/1*cnSPkEyZFbC5vV4qgEiV8g.png 1x\"><source media=\"(max-width: 430px) and (min-resolution: 2dppx)\" srcset=\"https://miro.medium.com/v2/resize:fit:700/1*cnSPkEyZFbC5vV4qgEiV8g.png 2x\"><source media=\"(max-width: 430px)\" srcset=\"https://miro.medium.com/v2/resize:fit:700/1*cnSPkEyZFbC5vV4qgEiV8g.png 1x\"><img src=\"https://miro.medium.com/v2/resize:fit:700/1*cnSPkEyZFbC5vV4qgEiV8g.png\" alt=\"\" style=\"width:100%;border-radius:0px\" class=\"_2fealp2 _2fealp5\"></picture></div></div><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\" style=\"--text-align:justify\"><span class=\"hxnnnr0\">El pasado </span><span class=\"hxnnnr0\"><strong>13 de agosto</strong></span><span class=\"hxnnnr0\">, la Universidad San Sebastián en Santiago fue el escenario de un evento clave para la comunidad chilena, el </span><span class=\"hxnnnr0\"><strong>Workshop Blockchain: Finanzas Descentralizadas y Smart Contracts con Stellar</strong></span><span class=\"hxnnnr0\">. Este encuentro fue organizado en colaboración con </span><span class=\"hxnnnr0\"><a href=\"https://medium.com/u/99518a49d085?source=post_page-----a84c69a5cfea--------------------------------\" target=\"_blank\" rel=\"\" class=\"_3k8pkd0\" style=\"--wt-inline-link-underline-color-override:#1a8917;--wt-inline-link-color-override:#1a8917\"><span style=\"font-family:inherit;--font-size:100%;--mobile-font-size:inherit\">Stellar Development Foundation</span></a></span><span class=\"hxnnnr0\"> y contó con el apoyo de diversas iniciativas y proyectos del ecosistema, como </span><span class=\"hxnnnr0\"><strong>Campus on Chain</strong></span><span class=\"hxnnnr0\">, </span><span class=\"hxnnnr0\"><a href=\"https://Soroswap.Finance\" target=\"_blank\" rel=\"\" class=\"_3k8pkd0\"><span style=\"font-family:inherit;--font-size:100%;--mobile-font-size:inherit\">Soroswap.Finance</span></a></span><span class=\"hxnnnr0\">, </span><span class=\"hxnnnr0\"><a href=\"https://medium.com/u/c3507d0aa69a?source=post_page-----a84c69a5cfea--------------------------------\" target=\"_blank\" rel=\"\" class=\"_3k8pkd0\" style=\"--wt-inline-link-underline-color-override:#1a8917;--wt-inline-link-color-override:#1a8917\"><span style=\"font-family:inherit;--font-size:100%;--mobile-font-size:inherit\">Tellus Cooperative</span></a></span><span class=\"hxnnnr0\">, </span><span class=\"hxnnnr0\"><strong>BeCoop Wallet y PaltaLabs</strong></span><span class=\"hxnnnr0\">.</span></p></div><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\" style=\"--text-align:justify\"><span class=\"hxnnnr0\">Para revivir lo mejor de este evento, hemos creado un reel que captura los momentos más destacados, las interacciones y las presentaciones que compartimos.</span></p></div><div id=\"quines-son-los-organizadores-y-cola\" class=\"hynlcx0\" style=\"--text-align:justify\"><h1 class=\"hynlcx1 hynlcx2\" translations=\"[object Object]\"><span class=\"hxnnnr0\"><strong>¿Quiénes son los organizadores y colaboradores?</strong></span></h1></div><div class=\"dream-post-content-bulletList _1ao94nj0\"><ul translations=\"[object Object]\" class=\"_1ao94nj1\"><li class=\"_11av8sw0\" translations=\"[object Object]\"><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\" style=\"--text-align:justify\"><span class=\"hxnnnr0\"><strong>Stellar Development Foundation</strong></span><span class=\"hxnnnr0\">: La fundación detrás de la red Stellar, que busca facilitar transacciones rápidas y económicas a nivel mundial. Stellar proporciona la infraestructura necesaria para aplicaciones blockchain innovadoras.</span><br><span class=\"hxnnnr0\"><a href=\"https://stellar.org/foundation\" target=\"_blank\" rel=\"\" class=\"_3k8pkd0\"><u style=\"text-decoration:underline\">https://stellar.org/foundation</u></a></span></p></div></li><li class=\"_11av8sw0\" translations=\"[object Object]\"><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\" style=\"--text-align:justify\"><span class=\"hxnnnr0\"><a href=\"https://paltalabs.io/\" target=\"_blank\" rel=\"ugc\" class=\"_3k8pkd0\" style=\"--wt-inline-link-underline-color-override:inherit;--wt-inline-link-color-override:inherit\"><strong><u style=\"text-decoration:underline\">PaltaLabs</u></strong></a></span><span class=\"hxnnnr0\"><a href=\"https://paltalabs.io/\" target=\"_blank\" rel=\"ugc\" class=\"_3k8pkd0\" style=\"--wt-inline-link-underline-color-override:inherit;--wt-inline-link-color-override:inherit\"><u style=\"text-decoration:underline\">:</u></a></span><span class=\"hxnnnr0\"> Especializados en el desarrollo de aplicaciones descentralizadas y consultoría en blockchain. PaltaLabs simplifica la creación de contratos inteligentes, destacando su protocolo </span><span class=\"hxnnnr0\"><a href=\"https://Soroswap.Finance\" target=\"_blank\" rel=\"\" class=\"_3k8pkd0\"><span style=\"font-family:inherit;--font-size:100%;--mobile-font-size:inherit\">Soroswap.Finance</span></a></span><span class=\"hxnnnr0\">, que ofrece transacciones seguras y eficientes en la red Stellar.</span></p></div></li><li class=\"_11av8sw0\" translations=\"[object Object]\"><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\" style=\"--text-align:justify\"><span class=\"hxnnnr0\"><a href=\"https://www.instagram.com/campusonchain/\" target=\"_blank\" rel=\"ugc\" class=\"_3k8pkd0\" style=\"--wt-inline-link-underline-color-override:inherit;--wt-inline-link-color-override:inherit\"><strong><u style=\"text-decoration:underline\">Campus on Chain</u></strong></a></span><span class=\"hxnnnr0\"><a href=\"https://www.instagram.com/campusonchain/\" target=\"_blank\" rel=\"ugc\" class=\"_3k8pkd0\" style=\"--wt-inline-link-underline-color-override:inherit;--wt-inline-link-color-override:inherit\"><u style=\"text-decoration:underline\">:</u></a></span><span class=\"hxnnnr0\"> Una iniciativa educativa dedicada a promover el conocimiento y la formación en tecnología blockchain. Campus on Chain organiza eventos y talleres para capacitar a la comunidad en el uso y desarrollo de tecnologías descentralizadas.</span></p></div></li><li class=\"_11av8sw0\" translations=\"[object Object]\"><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\" style=\"--text-align:justify\"><span class=\"hxnnnr0\"><a href=\"https://www.telluscoop.org/\" target=\"_blank\" rel=\"ugc\" class=\"_3k8pkd0\" style=\"--wt-inline-link-underline-color-override:inherit;--wt-inline-link-color-override:inherit\"><strong><u style=\"text-decoration:underline\">Tellus Cooperative</u></strong></a></span><span class=\"hxnnnr0\"><a href=\"https://www.telluscoop.org/\" target=\"_blank\" rel=\"ugc\" class=\"_3k8pkd0\" style=\"--wt-inline-link-underline-color-override:inherit;--wt-inline-link-color-override:inherit\"><u style=\"text-decoration:underline\">:</u></a></span><span class=\"hxnnnr0\"> Una entidad que impulsa el cooperativismo a través de la adopción de tecnologías descentralizadas. </span><span class=\"hxnnnr0\"><a href=\"https://medium.com/u/c3507d0aa69a?source=post_page-----a84c69a5cfea--------------------------------\" target=\"_blank\" rel=\"\" class=\"_3k8pkd0\" style=\"--wt-inline-link-underline-color-override:#1a8917;--wt-inline-link-color-override:#1a8917\"><span style=\"font-family:inherit;--font-size:100%;--mobile-font-size:inherit\">Tellus Cooperative</span></a></span><span class=\"hxnnnr0\"> busca transformar el modelo cooperativo en Chile, promoviendo una economía más inclusiva y sostenible mediante el uso de criptomonedas y blockchain.</span></p></div></li><li class=\"_11av8sw0\" translations=\"[object Object]\"><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\" style=\"--text-align:justify\"><span class=\"hxnnnr0\"><a href=\"https://Soroswap.Finance\" target=\"_blank\" rel=\"\" class=\"_3k8pkd0\"><strong><u style=\"text-decoration:underline\">Soroswap.Finance</u></strong></a></span><span class=\"hxnnnr0\"><a href=\"https://soroswap.finance/\" target=\"_blank\" rel=\"ugc\" class=\"_3k8pkd0\" style=\"--wt-inline-link-underline-color-override:inherit;--wt-inline-link-color-override:inherit\"><u style=\"text-decoration:underline\">: </u></a></span><span class=\"hxnnnr0\">Un protocolo de agregación DeFi en la red Stellar, que facilita intercambios rápidos y seguros de activos digitales. </span><span class=\"hxnnnr0\"><a href=\"https://Soroswap.Finance\" target=\"_blank\" rel=\"\" class=\"_3k8pkd0\">Soroswap.Finance</a></span><span class=\"hxnnnr0\"> se destaca por su eficiencia y su integración con la plataforma Stellar.</span></p></div></li><li class=\"_11av8sw0\" translations=\"[object Object]\"><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\" style=\"--text-align:justify\"><span class=\"hxnnnr0\"><a href=\"https://becoop.app/\" target=\"_blank\" rel=\"ugc\" class=\"_3k8pkd0\" style=\"--wt-inline-link-underline-color-override:inherit;--wt-inline-link-color-override:inherit\"><strong><u style=\"text-decoration:underline\">BeCoop Wallet</u></strong></a></span><span class=\"hxnnnr0\">: Una billetera móvil no custodial que permite a los usuarios gestionar sus activos digitales de forma segura y descentralizada. BeCoop se enfoca en la privacidad y la facilidad de uso, permitiendo transferencias rápidas y la administración eficiente de fondos sin intermediarios.</span><br><span class=\"hxnnnr0\"><a href=\"https://becoop.app/\" target=\"_blank\" rel=\"\" class=\"_3k8pkd0\"><u style=\"text-decoration:underline\">https://becoop.app/</u></a></span></p></div></li></ul></div><div id=\"qu-aprendimos-en-el-workshop\" class=\"hynlcx0\" style=\"--text-align:justify\"><h1 class=\"hynlcx1 hynlcx2\" translations=\"[object Object]\"><span class=\"hxnnnr0\"><strong>¿Qué aprendimos en el Workshop?</strong></span></h1></div><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\" style=\"--text-align:justify\"><span class=\"hxnnnr0\">El taller ofreció una </span><span class=\"hxnnnr0\"><strong>visión general de Soroban</strong></span><span class=\"hxnnnr0\">, la plataforma de contratos inteligentes de Stellar, destacando sus características únicas y su comparación con otras soluciones en el mercado. Los participantes se beneficiaron de una </span><span class=\"hxnnnr0\"><strong>demostración práctica</strong></span><span class=\"hxnnnr0\"> de la creación de contratos inteligentes, así como de presentaciones de proyectos innovadores construidos sobre la red Stellar.</span></p></div><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\" style=\"--text-align:justify\"><span class=\"hxnnnr0\">El evento también proporcionó una </span><span class=\"hxnnnr0\"><strong>oportunidad para explorar casos de uso reales y beneficios</strong></span><span class=\"hxnnnr0\"> de Soroban, mostrando cómo esta tecnología puede impulsar nuevas aplicaciones en el ámbito de las finanzas descentralizadas.</span></p></div><div class=\"dream-post-content-imageBlock _2fealp0\" style=\"--caption-alignment:center\"><div class=\"_2fealp1\"><picture><source media=\"(max-width: 360px) and (min-resolution: 2dppx)\" srcset=\"https://miro.medium.com/v2/resize:fit:960/1*6M7NEk7RoJMi3ShnznJskw.jpeg 2x\"><source media=\"(max-width: 360px)\" srcset=\"https://miro.medium.com/v2/resize:fit:960/1*6M7NEk7RoJMi3ShnznJskw.jpeg 1x\"><source media=\"(max-width: 430px) and (min-resolution: 2dppx)\" srcset=\"https://miro.medium.com/v2/resize:fit:960/1*6M7NEk7RoJMi3ShnznJskw.jpeg 2x\"><source media=\"(max-width: 430px)\" srcset=\"https://miro.medium.com/v2/resize:fit:960/1*6M7NEk7RoJMi3ShnznJskw.jpeg 1x\"><img src=\"https://miro.medium.com/v2/resize:fit:960/1*6M7NEk7RoJMi3ShnznJskw.jpeg\" alt=\"\" loading=\"lazy\" style=\"width:70%;border-radius:0px\" class=\"_2fealp2 _2fealp5\"></picture></div></div><div class=\"dream-post-content-imageBlock _2fealp0\" style=\"--caption-alignment:center\"><div class=\"_2fealp1\"><picture><source media=\"(max-width: 360px) and (min-resolution: 2dppx)\" srcset=\"https://miro.medium.com/v2/resize:fit:960/1*fv7FPUDOyVKKQTl_21IT5Q.jpeg 2x\"><source media=\"(max-width: 360px)\" srcset=\"https://miro.medium.com/v2/resize:fit:960/1*fv7FPUDOyVKKQTl_21IT5Q.jpeg 1x\"><source media=\"(max-width: 430px) and (min-resolution: 2dppx)\" srcset=\"https://miro.medium.com/v2/resize:fit:960/1*fv7FPUDOyVKKQTl_21IT5Q.jpeg 2x\"><source media=\"(max-width: 430px)\" srcset=\"https://miro.medium.com/v2/resize:fit:960/1*fv7FPUDOyVKKQTl_21IT5Q.jpeg 1x\"><img src=\"https://miro.medium.com/v2/resize:fit:960/1*fv7FPUDOyVKKQTl_21IT5Q.jpeg\" alt=\"\" loading=\"lazy\" style=\"width:80%;border-radius:0px\" class=\"_2fealp2 _2fealp5\"></picture></div></div><div id=\"nete-a-nosotros-y-explora-nuevas-op\" class=\"hynlcx0\" style=\"--text-a