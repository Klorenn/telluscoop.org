tered_viewed_count":null,"force_premium":false,"enforce_paywall_breaks":true,"display_thumbnail_on_web":true,"display_title_on_web":true,"display_subtitle_on_web":true,"author_urls":{"f296a348-b27c-4e82-ae84-fce2e49bff12":"https://blog.telluscoop.com/authors/pau-koh"},"custom_structured_data":null},"body":"<div class=\"_10pdwo80 dream-post-content-doc\"><div id=\"qu-es-xlm\" class=\"hynlcx0\"><h3 class=\"hynlcx1 hynlcx4\" translations=\"[object Object]\"><span class=\"hxnnnr0\"><strong> ¿Qué es XLM?</strong></span></h3></div><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\"><span class=\"hxnnnr0\"><strong>Stellar Lumens (XLM)</strong></span><span class=\"hxnnnr0\"> es la criptomoneda nativa de la red Stellar, una plataforma descentralizada enfocada en conectar sistemas financieros y facilitar pagos internacionales. A diferencia de Bitcoin, Stellar está optimizada para transacciones rápidas (3-5 segundos) y comisiones mínimas (0.00001 XLM por operación).</span></p></div><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\"><span class=\"hxnnnr0\"><strong>Características clave:</strong></span></p></div><div class=\"dream-post-content-bulletList _1ao94nj0\"><ul translations=\"[object Object]\" class=\"_1ao94nj1\"><li class=\"_11av8sw0\" translations=\"[object Object]\"><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\"><span class=\"hxnnnr0\"><strong>Enfoque en inclusión financiera</strong></span><span class=\"hxnnnr0\">: Ideal para remesas y servicios bancarios no tradicionales.</span></p></div></li><li class=\"_11av8sw0\" translations=\"[object Object]\"><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\"><span class=\"hxnnnr0\"><strong>Tokenización</strong></span><span class=\"hxnnnr0\">: Permite crear activos digitales vinculados a monedas fiduciarias (USD, EUR).</span></p></div></li><li class=\"_11av8sw0\" translations=\"[object Object]\"><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\"><span class=\"hxnnnr0\"><strong>Algoritmo de consenso</strong></span><span class=\"hxnnnr0\">: Utiliza el Protocolo de Consenso Stellar (SCP), más eficiente que Proof-of-Work.</span></p></div></li></ul></div><div class=\"_7pt7ks0\"><div class=\"_7pt7ks1\"></div></div><div id=\"dnde-comprar-xlm\" class=\"hynlcx0\"><h3 class=\"hynlcx1 hynlcx4\" translations=\"[object Object]\"><span class=\"hxnnnr0\"><strong>¿Dónde Comprar XLM?</strong></span></h3></div><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\"><span class=\"hxnnnr0\"><strong>Plataformas Recomendadas</strong></span></p></div><div id=\"a-exchanges-centralizados-cex\" class=\"hynlcx0\"><h4 class=\"hynlcx1 hynlcx5\" translations=\"[object Object]\"><span class=\"hxnnnr0\"><strong>A. Exchanges Centralizados (CEX)</strong></span></h4></div><div class=\"b7oqx90\" style=\"--cell-width:25%\"><table class=\"b7oqx91\"><tbody><tr><th class=\"_200kro0\"><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\"><span class=\"hxnnnr0\"><strong>Exchange</strong></span></p></div></th><th class=\"_200kro0\"><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\"><span class=\"hxnnnr0\"><strong>Ventajas</strong></span></p></div></th><th class=\"_200kro0\"><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\"><span class=\"hxnnnr0\"><strong>Desventajas</strong></span></p></div></th><th class=\"_200kro0\"><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\"><span class=\"hxnnnr0\"><strong>Link</strong></span></p></div></th></tr><tr><td class=\"ox1r470\" valign=\"top\"><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\"><span class=\"hxnnnr0\"><strong>Binance</strong></span></p></div></td><td class=\"ox1r470\" valign=\"top\"><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\"><span class=\"hxnnnr0\">Liquidez alta, múltiples pares de trading</span></p></div></td><td class=\"ox1r470\" valign=\"top\"><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\"><span class=\"hxnnnr0\">Interfaz compleja</span></p></div></td><td class=\"ox1r470\" valign=\"top\"><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\"><span class=\"hxnnnr0\"><a href=\"https://www.binance.com/\" target=\"_blank\" rel=\"\" class=\"_3k8pkd0\" style=\"--wt-inline-link-underline-color-override:rgb(var(--ds-rgb-link));--wt-inline-link-color-override:rgb(var(--ds-rgb-link))\">Binance</a></span></p></div></td></tr><tr><td class=\"ox1r470\" valign=\"top\"><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\"><span class=\"hxnnnr0\"><strong>Coinbase</strong></span></p></div></td><td class=\"ox1r470\" valign=\"top\"><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\"><span class=\"hxnnnr0\">Ideal para principiantes, regulado en EE.UU.</span></p></div></td><td class=\"ox1r470\" valign=\"top\"><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\"><span class=\"hxnnnr0\">Comisiones altas (~1.5%)</span></p></div></td><td class=\"ox1r470\" valign=\"top\"><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\"><span class=\"hxnnnr0\"><a href=\"https://www.coinbase.com/\" target=\"_blank\" rel=\"\" class=\"_3k8pkd0\" style=\"--wt-inline-link-underline-color-override:rgb(var(--ds-rgb-link));--wt-inline-link-color-override:rgb(var(--ds-rgb-link))\">Coinbase</a></span></p></div></td></tr><tr><td class=\"ox1r470\" valign=\"top\"><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\"><span class=\"hxnnnr0\"><strong>Kraken</strong></span></p></div></td><td class=\"ox1r470\" valign=\"top\"><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\"><span class=\"hxnnnr0\">Seguridad institucional, bajas comisiones</span></p></div></td><td class=\"ox1r470\" valign=\"top\"><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\"><span class=\"hxnnnr0\">Verificación rigurosa</span></p></div></td><td class=\"ox1r470\" valign=\"top\"><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\"><span class=\"hxnnnr0\"><a href=\"https://www.kraken.com/\" target=\"_blank\" rel=\"\" class=\"_3k8pkd0\" style=\"--wt-inline-link-underline-color-override:rgb(var(--ds-rgb-link));--wt-inline-link-color-override:rgb(var(--ds-rgb-link))\">Kraken</a></span></p></div></td></tr></tbody></table></div><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\"><span class=\"hxnnnr0\"><strong>Pasos para comprar:</strong></span></p></div><div class=\"vl18bi0\"><ol class=\"vl18bi1\" translations=\"[object Object]\" start=\"1\"><li class=\"_11av8sw0\" translations=\"[object Object]\"><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\"><span class=\"hxnnnr0\"><strong>Registro</strong></span><span class=\"hxnnnr0\">: Crea una cuenta y completa el KYC (verificación de identidad).</span></p></div></li><li class=\"_11av8sw0\" translations=\"[object Object]\"><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\"><span class=\"hxnnnr0\"><strong>Depósito</strong></span><span class=\"hxnnnr0\">: Transfiere fondos vía tarjeta, transferencia bancaria o otra cripto.</span></p></div></li><li class=\"_11av8sw0\" translations=\"[object Object]\"><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\"><span class=\"hxnnnr0\"><strong>Compra</strong></span><span class=\"hxnnnr0\">: Busca el par XLM/USD o XLM/BTC y ejecuta tu orden.</span></p></div></li></ol></div><div id=\"b-exchanges-descentralizados-dex\" class=\"hynlcx0\"><h4 class=\"hynlcx1 hynlcx5\" translations=\"[object Object]\"><span class=\"hxnnnr0\"><strong>B. Exchanges Descentralizados (DEX)</strong></span></h4></div><div class=\"dream-post-content-bulletList _1ao94nj0\"><ul translations=\"[object Object]\" class=\"_1ao94nj1\"><li class=\"_11av8sw0\" translations=\"[object Object]\"><div cl