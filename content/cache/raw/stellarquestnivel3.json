{"meta":{"id":"5bfe459b-78bd-4d60-860f-d7cddc8cf4c9","publication_id":"30c7e4c1-15ed-46d8-a23d-32c90e011794","web_title":"¡Aprendizajes del Nivel 3 en Stellar Quest! 🚀","parameterized_web_title":"aprendizajes-del-nivel-3-en-stellar-quest","utm_params_enabled":true,"utm_campaign":"aprendizajes-del-nivel-3-en-stellar-quest","utm_medium":"referral","utm_source":"blog.telluscoop.com","web_subtitle":"","web_audiences":"free","status":"published","active":true,"featured":false,"override_scheduled_at":"2025-03-02T13:27:45.526Z","slug":"stellarquestnivel3","is_premium":false,"image_url":"https://beehiiv-images-production.s3.amazonaws.com/uploads/asset/file/615bda54-065c-44c0-b13c-35dc03460d6a/Notion_-_Quest_3.png?t=1740921517","image_width":1292,"image_height":646,"meta_default_title":"¡Aprendizajes del Nivel 3 en Stellar Quest! 🚀","meta_default_description":"La Cooperativa Blockchain de LatAm","meta_og_title":"¡Aprendizajes del Nivel 3 en Stellar Quest! 🚀","meta_og_description":"La Cooperativa Blockchain de LatAm","meta_twitter_title":"¡Aprendizajes del Nivel 3 en Stellar Quest! 🚀","meta_twitter_description":"La Cooperativa Blockchain de LatAm","audience":"free","comments_enabled":true,"comments_state":"default","enforce_gated_content":true,"enable_popup_on_scroll":false,"email_capture_title":"Suscríbete para seguir leyendo","email_capture_message":"Este contenido es gratuito, pero debes estar suscrito a Tellus Cooperative para continuar leyendo.","email_capture_cta":"Suscríbete","estimated_reading_time":3,"estimated_reading_time_display":"3 minutos","paywall_id":null,"authors":[{"id":"f296a348-b27c-4e82-ae84-fce2e49bff12","name":"Pau Koh","profile_picture":{"url":"https://beehiiv-images-production.s3.amazonaws.com/uploads/user/profile_picture/f296a348-b27c-4e82-ae84-fce2e49bff12/pau_headshot_1.png","thumb":{"url":"https://beehiiv-images-production.s3.amazonaws.com/uploads/user/profile_picture/f296a348-b27c-4e82-ae84-fce2e49bff12/thumb_pau_headshot_1.png"},"landscape":{"url":"https://beehiiv-images-production.s3.amazonaws.com/uploads/user/profile_picture/f296a348-b27c-4e82-ae84-fce2e49bff12/landscape_pau_headshot_1.png"}},"bio":"𝘊𝘔𝘎𝘙/𝘛𝘦𝘭𝘭𝘶𝘴 𝘊𝘰𝘰𝘱𝘦𝘳𝘢𝘵𝘪𝘷𝘦","twitter_handle":"kl0ren","facebook_url":null,"instagram_url":null,"linkedin_url":null,"tiktok_url":null,"youtube_url":null,"discord_url":null,"bluesky_url":null}],"content_tags":[],"created_at":"2025-03-02T13:17:20Z","updated_at":"2025-03-02T13:28:05Z","html":null,"hide_premium_post":false,"contains_subscriber_break":false,"is_accessible_for_free":true,"paywall_shown":false,"metered_usage_shown":false,"metered_viewed_count":null,"force_premium":false,"enforce_paywall_breaks":true,"display_thumbnail_on_web":true,"display_title_on_web":true,"display_subtitle_on_web":true,"author_urls":{"f296a348-b27c-4e82-ae84-fce2e49bff12":"https://blog.telluscoop.com/authors/pau-koh"},"custom_structured_data":null},"body":"<div class=\"_10pdwo80 dream-post-content-doc\"><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\"><span class=\"hxnnnr0\">¡Hola a todos! </span><span class=\"dl6s8g0 hxnnnr0\">👋</span></p></div><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\"><span class=\"hxnnnr0\">Queremos tomarnos un momento para agradecer a todos los que asistieron y participaron en el emocionante </span><span class=\"hxnnnr0\"><strong>Nivel 3</strong></span><span class=\"hxnnnr0\"> de nuestra serie de videos educativos sobre </span><span class=\"hxnnnr0\"><strong>Stellar</strong></span><span class=\"hxnnnr0\">. Durante esta sesión, exploramos conceptos avanzados que son clave para entender cómo funciona la red Stellar. Aquí te contamos de manera sencilla lo que hicimos y aprendimos.</span></p></div><div class=\"_7pt7ks0\"><div class=\"_7pt7ks1\"></div></div><div id=\"1-bump-sequence-aumentando-el-nmero\" class=\"hynlcx0\"><h3 class=\"hynlcx1 hynlcx4\" translations=\"[object Object]\"><span class=\"hxnnnr0\"><strong>1. Bump Sequence: Aumentando el Número de Secuencia</strong></span></h3></div><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\"><span class=\"hxnnnr0\"><strong>¿Qué hicimos?</strong></span><br><span class=\"hxnnnr0\">Aprendimos cómo incrementar el número de secuencia de una cuenta. Este número es crucial porque ayuda a identificar y verificar las transacciones en la red, evitando el uso indebido de fondos.</span></p></div><div class=\"dream-post-content-bulletList _1ao94nj0\"><ul translations=\"[object Object]\" class=\"_1ao94nj1\"><li class=\"_11av8sw0\" translations=\"[object Object]\"><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\"><span class=\"hxnnnr0\"><strong>Pasos</strong></span><span class=\"hxnnnr0\">:</span></p></div><div class=\"dream-post-content-bulletList _1ao94nj0\"><ul translations=\"[object Object]\" class=\"_1ao94nj1\"><li class=\"_11av8sw0\" translations=\"[object Object]\"><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\"><span class=\"hxnnnr0\">Navegamos al </span><span class=\"hxnnnr0\"><strong>Stellar Laboratory</strong></span><span class=\"hxnnnr0\"> y construimos una transacción para aumentar el número de secuencia de nuestra cuenta del Quest.</span></p></div></li><li class=\"_11av8sw0\" translations=\"[object Object]\"><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\"><span class=\"hxnnnr0\">Firmamos y enviamos esta transacción a la testnet.</span></p></div></li><li class=\"_11av8sw0\" translations=\"[object Object]\"><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\"><span class=\"hxnnnr0\">Luego, realizamos otra transacción utilizando el nuevo número de secuencia.</span></p></div></li><li class=\"_11av8sw0\" translations=\"[object Object]\"><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\"><span class=\"hxnnnr0\">¡Y listo! Verificamos que todo estaba correcto y reclamamos nuestra insignia. </span><span class=\"dl6s8g0 hxnnnr0\">🏅</span></p></div></li></ul></div></li></ul></div><div class=\"py-2\"><div class=\"twitter-wrapper mx-auto max-w-[520px]\"><blockquote class=\"twitter-tweet text-center\"><a href=\"https://twitter.com/Stellar_Chile/status/1895174306654756894\"><p>— #<!-- --> (#<!-- -->)<br></p></a></blockquote></div></div><div class=\"_7pt7ks0\"><div class=\"_7pt7ks1\"></div></div><div id=\"2-sponsorships-patrocinando-cuentas\" class=\"hynlcx0\"><h3 class=\"hynlcx1 hynlcx4\" translations=\"[object Object]\"><span class=\"hxnnnr0\"><strong>2. Sponsorships: Patrocinando Cuentas</strong></span></h3></div><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\"><span class=\"hxnnnr0\"><strong>¿Qué hicimos?</strong></span><br><span class=\"hxnnnr0\">Aprendimos sobre cómo se pueden patrocinar las cuentas en Stellar. Esto es importante porque permite que una cuenta cubra el costo de las reservas necesarias para que otra cuenta pueda existir.</span></p></div><div class=\"dream-post-content-bulletList _1ao94nj0\"><ul translations=\"[object Object]\" class=\"_1ao94nj1\"><li class=\"_11av8sw0\" translations=\"[object Object]\"><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\"><span class=\"hxnnnr0\"><strong>Pasos</strong></span><span class=\"hxnnnr0\">:</span></p></div><div class=\"dream-post-content-bulletList _1ao94nj0\"><ul translations=\"[object Object]\" class=\"_1ao94nj1\"><li class=\"_11av8sw0\" translations=\"[object Object]\"><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\"><span class=\"hxnnnr0\">Creamos una nueva cuenta en la testnet que actuó como nuestra cuenta patrocinadora.</span></p></div></li><li class=\"_11av8sw0\" translations=\"[object Object]\"><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\"><span class=\"hxnnnr0\">Construimos una transacción que creó nuestra cuenta del Quest, asegurándonos de que la cuenta patrocinadora pagara las reservas necesarias.</span></p></div></li><li class=\"_11av8sw0\" translations=\"[object Object]\"><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\"><span class=\"hxnnnr0\">Firmamos y enviamos la transacción, y al final, ¡reclamamos otra insignia! 🎖️</span></p></div></li></ul></div></li></ul></div><div class=\"_7pt7ks0\"><div class=\"_7pt7ks1\"></div></div><div id=\"3-claimable-balances-fondos-a-la-vi\" class=\"hynlcx0\"><h3 class=\"hynlcx1 hynlcx4\" translations=\"[object Object]\"><span class=\"hxnnnr0\"><strong>3. Claimable Balances: ¡Fondos a la Vista!</strong></span></h3></div><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\"><span class=\"hxnnnr0\"><strong>¿Qué hicimos?</strong></span><br><span class=\"hxnnnr0\">Exploramos cómo enviar una cantidad de un activo desde una cuenta fuente para que otra cuenta pueda reclamarlo más tarde. ¡Es como reservar dinero para un amigo!</span></p></div><div class=\"dream-post-content-bulletList _1ao94nj0\"><ul translations=\"[object Object]\" class=\"_1ao94nj1\"><li class=\"_11av8sw0\" translations=\"[object Object]\"><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\"><span class=\"hxnnnr0\"><strong>Pasos</strong></span><span class=\"hxnnnr0\">:</span></p></div><div class=\"dream-post-content-bulletList _1ao94nj0\"><ul translations=\"[object Object]\" class=\"_1ao94nj1\"><li class=\"_11av8sw0\" translations=\"[object Object]\"><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\"><span class=\"hxnnnr0\">Creamos una nueva cuenta para usar como destinatario.</span></p></div></li><li class=\"_11av8sw0\" translations=\"[object Object]\"><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\"><span class=\"hxnnnr0\">Desde nuestra cuenta del Quest, creamos un </span><span class=\"hxnnnr0\"><strong>Claimable Balance</strong></span><span class=\"hxnnnr0\">, asegurándonos de que la nueva cuenta no pudiera reclamarlo inmediatamente.</span></p></div></li><li class=\"_11av8sw0\" translations=\"[object Object]\"><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\"><span class=\"hxnnnr0\">Después de esperar un poco, construimos otra transacción para que la nueva cuenta pudiera reclamar el balance.</span></p></div></li><li class=\"_11av8sw0\" translations=\"[object Object]\"><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\"><span class=\"hxnnnr0\">¡Firmamos, enviamos y reclamamos otra insignia! </span><span class=\"dl6s8g0 hxnnnr0\">🌟</span></p></div></li></ul></div></li></ul></div><div class=\"py-2\"><div class=\"twitter-wrapper mx-auto max-w-[520px]\"><blockquote class=\"twitter-tweet text-center\"><a href=\"https://twitter.com/Stellar_Chile/status/1892636179276632244\"><p>— #<!-- --> (#<!-- -->)<br></p></a></blockquote></div></div><div class=\"_7pt7ks0\"><div class=\"_7pt7ks1\"></div></div><div id=\"4-clawbacks-recuperando-activos\" class=\"hynlcx0\"><h3 class=\"hynlcx1 hynlcx4\" translations=\"[object Object]\"><span class=\"hxnnnr0\"><strong>4. Clawbacks: Recuperando Activos</strong></span></h3></div><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\"><span class=\"hxnnnr0\"><strong>¿Qué hicimos?</strong></span><br><span class=\"hxnnnr0\">Aprendimos sobre la operación de clawback, que permite recuperar activos enviados en ciertas condiciones. Esto es útil para corregir errores o cumplir con regulaciones.</span></p></div><div class=\"dream-post-content-bulletList _1ao94nj0\"><ul translations=\"[object Object]\" class=\"_1ao94nj1\"><li class=\"_11av8sw0\" translations=\"[object Object]\"><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\"><span class=\"hxnnnr0\"><strong>Pasos</strong></span><span class=\"hxnnnr0\">:</span></p></div><div class=\"dream-post-content-bulletList _1ao94nj0\"><ul translations=\"[object Object]\" class=\"_1ao94nj1\"><li class=\"_11av8sw0\" translations=\"[object Object]\"><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\"><span class=\"hxnnnr0\">Habilitamos la opción de </span><span class=\"hxnnnr0\"><strong>Clawback</strong></span><span class=\"hxnnnr0\"> en nuestra cuenta del Quest.</span></p></div></li><li class=\"_11av8sw0\" translations=\"[object Object]\"><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\"><span class=\"hxnnnr0\">Emitimos un activo a una nueva cuenta.</span></p></div></li><li class=\"_11av8sw0\" translations=\"[object Object]\"><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\"><span class=\"hxnnnr0\">Luego, construimos una transacción para recuperar parte del activo de la otra cuenta.</span></p></div></li><li class=\"_11av8sw0\" translations=\"[object Object]\"><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\"><span class=\"hxnnnr0\">¡Todo salió bien y reclamamos nuestra insignia! 🏆</span></p></div></li></ul></div></li></ul></div><div class=\"_7pt7ks0\"><div class=\"_7pt7ks1\"></div></div><div id=\"5-liquidity-pools-sumergindonos-en-\" class=\"hynlcx0\"><h3 class=\"hynlcx1 hynlcx4\" translations=\"[object Object]\"><span class=\"hxnnnr0\"><strong>5. Liquidity Pools: ¡Sumergiéndonos en el Agua!</strong></span></h3></div><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\"><span class=\"hxnnnr0\"><strong>¿Qué hicimos?</strong></span><br><span class=\"hxnnnr0\">Finalmente, aprendimos sobre los </span><span class=\"hxnnnr0\"><strong>Liquidity Pools</strong></span><span class=\"hxnnnr0\">. Estos son esenciales para facilitar el intercambio de activos en la red.</span></p></div><div class=\"dream-post-content-bulletList _1ao94nj0\"><ul translations=\"[object Object]\" class=\"_1ao94nj1\"><li class=\"_11av8sw0\" translations=\"[object Object]\"><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\"><span class=\"hxnnnr0\"><strong>Pasos</strong></span><span class=\"hxnnnr0\">:</span></p></div><div class=\"dream-post-content-bulletList _1ao94nj0\"><ul translations=\"[object Object]\" class=\"_1ao94nj1\"><li class=\"_11av8sw0\" translations=\"[object Object]\"><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\"><span class=\"hxnnnr0\">Establecimos una </span><span class=\"hxnnnr0\"><strong>trustline</strong></span><span class=\"hxnnnr0\"> para el nuevo pool de liquidez.</span></p></div></li><li class=\"_11av8sw0\" translations=\"[object Object]\"><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\"><span class=\"hxnnnr0\">Realizamos un depósito inicial de activos en el pool y recibimos acciones a cambio.</span></p></div></li><li class=\"_11av8sw0\" translations=\"[object Object]\"><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\"><span class=\"hxnnnr0\">Luego, hicimos un </span><span class=\"hxnnnr0\"><strong>Path Payment</strong></span><span class=\"hxnnnr0\"> utilizando el pool de liquidez.</span></p></div></li><li class=\"_11av8sw0\" translations=\"[object Object]\"><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\"><span class=\"hxnnnr0\">Para terminar, retiramos nuestras acciones del pool y reclamamos las recompensas de tarifas generadas.</span></p></div></li><li class=\"_11av8sw0\" translations=\"[object Object]\"><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\"><span class=\"hxnnnr0\">¡Y otra insignia más para nosotros! </span><span class=\"dl6s8g0 hxnnnr0\">🎊</span></p></div></li></ul></div></li></ul></div><div class=\"py-2\"><div class=\"twitter-wrapper mx-auto max-w-[520px]\"><blockquote class=\"twitter-tweet text-center\"><a href=\"https://twitter.com/TellusCoop/status/1890717710805262714\"><p>— #<!-- --> (#<!-- -->)<br></p></a></blockquote></div></div><div class=\"_7pt7ks0\"><div class=\"_7pt7ks1\"></div></div><div id=\"gracias-por-participar\" class=\"hynlcx0\"><h3 class=\"hynlcx1 hynlcx4\" translations=\"[object Object]\"><span class=\"hxnnnr0\">¡Gracias por Participar!</span></h3></div><div data-generic-embed-container=\"true\" class=\"_8dv9ja0\"><a href=\"https://stellarchile.start.page/\" target=\"_blank\"><div class=\"_8dv9ja2\" style=\"--generic-embed-image-width:40%\"><div data-generic-embed-layout=\"true\" class=\"border-collapse w-full flex sm:flex-row flex-col-reverse\"><div class=\"_8dv9ja1\"><div data-generic-embed-title=\"true\" class=\"rq7pc90\"><p class=\"rq7pc91\"><span class=\"hxnnnr0\">Stellar Chile</span></p></div><div data-generic-embed-description=\"true\" class=\"_1uh4x2v0\"><p class=\"_1uh4x2v2\"><span class=\"hxnnnr0\">Estamos muy emocionados por todo lo que aprendimos juntos en este nivel. Recuerda que puedes participar por swag exclusivo visitando telluscoop.com/stellar.</span></p></div><div data-generic-embed-host=\"true\" class=\"efatai0\"><p class=\"efatai1\"><span class=\"hxnnnr0\">telluscoop.com/stellar.</span></p></div></div><div data-generic-embed-image-wrapper=\"true\" data-generic-embed-image-right=\"true\" class=\"w-full mb-[20px] sm:mb-0 sm:ml-[20px] sm:w-[var(--generic-embed-image-width)] sm:basis-[var(--generic-embed-image-width)] flex\" style=\"align-self:center\"><img src=\"https://media.beehiiv.com/cdn-cgi/image/fit=scale-down,quality=80,format=auto,onerror=redirect/uploads/asset/file/7ba5ce5c-2995-41de-be92-91e5375fb5ba/image_49.png?t=1740921867\" class=\"w-full h-auto object-cover\" alt=\"\"></div></div></div></a></div><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\"><span class=\"hxnnnr0\">¡Sigamos aprendiendo y creciendo juntos en el mundo de Stellar! Si tienes preguntas o quieres compartir tus experiencias, ¡déjanos un comentario!</span></p></div><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\"><span class=\"hxnnnr0\">¡Hasta la próxima! </span><span class=\"dl6s8g0 hxnnnr0\">🌌</span></p></div></div>","publication":{"name":"Tellus Cooperative","description":"La Cooperativa Blockchain de LatAm","url":"https://blog.telluscoop.com/","twitter_url":"https://x.com/telluscoop","instagram_url":"https://instagram.com/telluscoop","linkedin_url":"https://linkedin.com/company/Tellus-Cooperative","youtube_url":"https://youtube.com/@telluscoop","discord_url":"https://discord.gg/V4eSGWA3PK"}}