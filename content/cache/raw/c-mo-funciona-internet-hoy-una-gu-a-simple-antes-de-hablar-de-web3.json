ble_popup_on_scroll":false,"email_capture_title":"Suscríbete para seguir leyendo","email_capture_message":"Este contenido es gratuito, pero debes estar suscrito a Tellus Cooperative para continuar leyendo.","email_capture_cta":"Suscríbete","estimated_reading_time":4,"estimated_reading_time_display":"4 minutos","paywall_id":null,"authors":[{"id":"f296a348-b27c-4e82-ae84-fce2e49bff12","name":"Pau Koh","profile_picture":{"url":"https://beehiiv-images-production.s3.amazonaws.com/uploads/user/profile_picture/f296a348-b27c-4e82-ae84-fce2e49bff12/pau_headshot_1.png","thumb":{"url":"https://beehiiv-images-production.s3.amazonaws.com/uploads/user/profile_picture/f296a348-b27c-4e82-ae84-fce2e49bff12/thumb_pau_headshot_1.png"},"landscape":{"url":"https://beehiiv-images-production.s3.amazonaws.com/uploads/user/profile_picture/f296a348-b27c-4e82-ae84-fce2e49bff12/landscape_pau_headshot_1.png"}},"bio":"𝘊𝘔𝘎𝘙/𝘛𝘦𝘭𝘭𝘶𝘴 𝘊𝘰𝘰𝘱𝘦𝘳𝘢𝘵𝘪𝘷𝘦","twitter_handle":"kl0ren","facebook_url":null,"instagram_url":null,"linkedin_url":null,"tiktok_url":null,"youtube_url":null,"discord_url":null,"bluesky_url":null}],"content_tags":[{"id":"89c8fef5-1da9-4d08-b488-2fc2c71796bf","display":"Educación","slug":"educacion"},{"id":"f3f92fa9-b675-4f89-a63c-515c1a62637a","display":"Información","slug":"informacion"}],"created_at":"2026-01-09T14:30:26Z","updated_at":"2026-01-12T13:01:49Z","html":null,"hide_premium_post":false,"contains_subscriber_break":false,"is_accessible_for_free":true,"paywall_shown":false,"metered_usage_shown":false,"metered_viewed_count":null,"force_premium":false,"enforce_paywall_breaks":true,"display_thumbnail_on_web":false,"display_title_on_web":true,"display_subtitle_on_web":true,"author_urls":{"f296a348-b27c-4e82-ae84-fce2e49bff12":"https://blog.telluscoop.com/authors/pau-koh"},"custom_structured_data":null},"body":"<div class=\"_10pdwo80 dream-post-content-doc\"><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\"><span class=\"hxnnnr0\">Usamos Internet todos los días, pero muy pocas personas entienden </span><span class=\"hxnnnr0\"><strong>cómo funciona el modelo actual</strong></span><span class=\"hxnnnr0\"> ni por qué aparecen conceptos como Web3, blockchain o descentralización.</span><br><span class=\"hxnnnr0\">Antes de hablar del futuro, primero necesitamos entender </span><span class=\"hxnnnr0\"><strong>el presente</strong></span><span class=\"hxnnnr0\">.</span></p></div><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\"><span class=\"hxnnnr0\">Esta guía es el punto de partida de la serie </span><span class=\"hxnnnr0\"><strong>“De 0 a Web3”</strong></span><span class=\"hxnnnr0\">: sin tecnicismos, sin hype y sin promesas.</span></p></div><div id=\"internet-no-siempre-fue-como-lo-con\" class=\"hynlcx0\"><h2 class=\"hynlcx1 hynlcx3\" translations=\"[object Object]\"><span class=\"hxnnnr0\">Internet no siempre fue como lo conocemos hoy</span></h2></div><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\"><span class=\"hxnnnr0\">Para entender cómo funciona Internet hoy, conviene mirarlo como una </span><span class=\"hxnnnr0\"><strong>evolución en etapas</strong></span><span class=\"hxnnnr0\">. No son versiones que se “actualizan”, sino formas distintas de usar la red.</span></p></div><div id=\"web-1-solo-leer-los-inicios-de-inte\" class=\"hynlcx0\"><h3 class=\"hynlcx1 hynlcx4\" translations=\"[object Object]\"><span class=\"hxnnnr0\">Web1: solo leer (los inicios de Internet)</span></h3></div><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\"><span class=\"hxnnnr0\">La </span><span class=\"hxnnnr0\"><strong>Web1</strong></span><span class=\"hxnnnr0\"> fue el Internet de los años 90 y principios de los 2000.</span></p></div><div class=\"dream-post-content-bulletList _1ao94nj0\"><ul translations=\"[object Object]\" class=\"_1ao94nj1\"><li class=\"_11av8sw0\" translations=\"[object Object]\"><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\"><span class=\"hxnnnr0\">Las páginas eran estáticas</span></p></div></li><li class=\"_11av8sw0\" translations=\"[object Object]\"><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\"><span class=\"hxnnnr0\">No podías comentar, subir contenido ni interactuar</span></p></div></li><li class=\"_11av8sw0\" translations=\"[object Object]\"><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\"><span class=\"hxnnnr0\">Eras un lector, no un participante</span></p></div></li></ul></div><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\"><span class=\"hxnnnr0\">Ejemplo simple:</span><br><span class=\"hxnnnr0\">Un sitio web que funcionaba como</span><span class=\"hxnnnr0\"><code>çç</code></span><span class=\"hxnnnr0\"> un diario digital. Entrabas, leías y te ibas.</span></p></div><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\"><span class=\"hxnnnr0\">👉 </span><span class=\"hxnnnr0\"><strong>Control:</strong></span><span class=\"hxnnnr0\"> del dueño del sitio</span><br><span class=\"hxnnnr0\">👉 </span><span class=\"hxnnnr0\"><strong>Usuarios:</strong></span><span class=\"hxnnnr0\"> pasivos</span></p></div><div id=\"web-2-interactuar-pero-no-ser-dueo\" class=\"hynlcx0\"><h3 class=\"hynlcx1 hynlcx4\" translations=\"[object Object]\"><span class=\"hxnnnr0\">Web2: interactuar, pero no ser dueño</span></h3></div><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\"><span class=\"hxnnnr0\">La </span><span class=\"hxnnnr0\"><strong>Web2</strong></span><span class=\"hxnnnr0\"> es el Internet que usamos hoy.</span></p></div><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\"><span class=\"hxnnnr0\">Aquí aparecen:</span></p></div><div class=\"dream-post-content-bulletList _1ao94nj0\"><ul translations=\"[object Object]\" class=\"_1ao94nj1\"><li class=\"_11av8sw0\" translations=\"[object Object]\"><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\"><span class=\"hxnnnr0\">Redes sociales</span></p></div></li><li class=\"_11av8sw0\" translations=\"[object Object]\"><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\"><span class=\"hxnnnr0\">Plataformas de streaming</span></p></div></li><li class=\"_11av8sw0\" translations=\"[object Object]\"><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\"><span class=\"hxnnnr0\">Apps bancarias</span></p></div></li><li class=\"_11av8sw0\" translations=\"[object Object]\"><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\"><span class=\"hxnnnr0\">Marketplaces</span></p></div></li><li class=\"_11av8sw0\" translations=\"[object Object]\"><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\"><span class=\"hxnnnr0\">Servicios en la nube</span></p></div></li></ul></div><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\"><span class=\"hxnnnr0\">Ahora sí puedes:</span></p></div><div class=\"dream-post-content-bulletList _1ao94nj0\"><ul translations=\"[object Object]\" class=\"_1ao94nj1\"><li class=\"_11av8sw0\" translations=\"[object Object]\"><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\"><span class=\"hxnnnr0\">Crear contenido</span></p></div></li><li class=\"_11av8sw0\" translations=\"[object Object]\"><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\"><span class=\"hxnnnr0\">Comentar</span></p></div></li><li class=\"_11av8sw0\" translations=\"[object Object]\"><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\"><span class=\"hxnnnr0\">Enviar dinero</span></p></div></li><li class=\"_11av8sw0\" translations=\"[object Object]\"><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\"><span class=\"hxnnnr0\">Comprar, vender, trabajar</span></p></div></li></ul></div><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\"><span class=\"hxnnnr0\">Pero hay un detalle clave 👇</span><br><span class=\"hxnnnr0\"><strong>Interactúas, pero no eres dueño.</strong></span></p></div><div id=\"el-rol-central-de-las-plataformas\" class=\"hynlcx0\"><h2 class=\"hynlcx1 hynlcx3\" translations=\"[object Object]\"><span class=\"hxnnnr0\">El rol central de las plataformas</span></h2></div><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\"><span class=\"hxnnnr0\">En la Web2, casi todo pasa por </span><span class=\"hxnnnr0\"><strong>plataformas intermediarias</strong></span><span class=\"hxnnnr0\">:</span></p></div><div class=\"dream-post-content-bulletList _1ao94nj0\"><ul translations=\"[object Object]\" class=\"_1ao94nj1\"><li class=\"_11av8sw0\" translations=\"[object Object]\"><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\"><span class=\"hxnnnr0\">Redes sociales → Meta, X, TikTok</span></p></div></li><li class=\"_11av8sw0\" translations=\"[object Object]\"><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\"><span class=\"hxnnnr0\">Bancos → instituciones financieras</span></p></div></li><li class=\"_11av8sw0\" translations=\"[object Object]\"><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\"><span class=\"hxnnnr0\">Apps → empresas privadas</span></p></div></li><li class=\"_11av8sw0\" translations=\"[object Object]\"><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\"><span class=\"hxnnnr0\">Datos → servidores centralizados</span></p></div></li></ul></div><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\"><span class=\"hxnnnr0\">Estas plataformas:</span></p></div><div class=\"dream-post-content-bulletList _1ao94nj0\"><ul translations=\"[object Object]\" class=\"_1ao94nj1\"><li class=\"_11av8sw0\" translations=\"[object Object]\"><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\"><span class=\"hxnnnr0\">Guardan tus datos</span></p></div></li><li class=\"_11av8sw0\" translations=\"[object Object]\"><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\"><span class=\"hxnnnr0\">Definen las reglas</span></p></div></li><li class=\"_11av8sw0\" translations=\"[object Object]\"><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\"><span class=\"hxnnnr0\">Pueden cambiar condiciones</span></p></div></li><li class=\"_11av8sw0\" translations=\"[object Object]\"><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\"><span class=\"hxnnnr0\">Pueden cerrar tu cuenta</span></p></div></li><li class=\"_11av8sw0\" translations=\"[object Object]\"><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\"><span class=\"hxnnnr0\">Pueden monetizar tu información</span></p></div></li></ul></div><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\"><span class=\"hxnnnr0\">Tú usas el servicio, pero </span><span class=\"hxnnnr0\"><strong>no controlas la infraestructura</strong></span><span class=\"hxnnnr0\">.</span></p></div><div id=\"ejemplos-cotidianos-sin-tecnicismos\" class=\"hynlcx0\"><h2 class=\"hynlcx1 hynlcx3\" translations=\"[object Object]\"><span class=\"hxnnnr0\">Ejemplos cotidianos (sin tecnicismos)</span></h2></div><div id=\"redes-sociales\" class=\"hynlcx0\"><h3 class=\"hynlcx1 hynlcx4\" translations=\"[object Object]\"><span class=\"hxnnnr0\">Redes sociales</span></h3></div><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\"><span class=\"hxnnnr0\">Subes fotos, escribes posts, construyes audiencia.</span><br><span class=\"hxnnnr0\">Pero:</span></p></div><div class=\"dream-post-content-bulletList _1ao94nj0\"><ul translations=\"[object Object]\" class=\"_1ao94nj1\"><li class=\"_11av8sw0\" translations=\"[object Object]\"><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\"><span class=\"hxnnnr0\">La plataforma es dueña del contenido</span></p></div></li><li class=\"_11av8sw0\" translations=\"[object Object]\"><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\"><span class=\"hxnnnr0\">Puede bajar tu cuenta</span></p></div></li><li class=\"_11av8sw0\" translations=\"[object Object]\"><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\"><span class=\"hxnnnr0\">Decide qué se muestra y qué no</span></p></div></li></ul></div><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\"><span class=\"hxnnnr0\">Tu perfil </span><span class=\"hxnnnr0\"><strong>no te pertenece</strong></span><span class=\"hxnnnr0\">, está “prestado”.</span></p></div><div id=\"bancos\" class=\"hynlcx0\"><h3 class=\"hynlcx1 hynlcx4\" translations=\"[object Object]\"><span class=\"hxnnnr0\">Bancos</span></h3></div><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\"><span class=\"hxnnnr0\">Tu dinero:</span></p></div><div class=\"dream-post-content-bulletList _1ao94nj0\"><ul translations=\"[object Object]\" class=\"_1ao94nj1\"><li class=\"_11av8sw0\" translations=\"[object Object]\"><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\"><span class=\"hxnnnr0\">Está en el banco</span></p></div></li><li class=\"_11av8sw0\" translations=\"[object Object]\"><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\"><span class=\"hxnnnr0\">Se mueve bajo sus reglas</span></p></div></li><li class=\"_11av8sw0\" translations=\"[object Object]\"><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\"><span class=\"hxnnnr0\">Depende de horarios, permisos y validaciones</span></p></div></li></ul></div><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\"><span class=\"hxnnnr0\">No tienes control directo sobre la infraestructura financiera.</span></p></div><div id=\"apps-y-servicios-digitales\" class=\"hynlcx0\"><h3 class=\"hynlcx1 hynlcx4\" translations=\"[object Object]\"><span class=\"hxnnnr0\">Apps y servicios digitales</span></h3></div><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\"><span class=\"hxnnnr0\">Usas:</span></p></div><div class=\"dream-post-content-bulletList _1ao94nj0\"><ul translations=\"[object Object]\" class=\"_1ao94nj1\"><li class=\"_11av8sw0\" translations=\"[object Object]\"><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\"><span class=\"hxnnnr0\">Google Drive</span></p></div></li><li class=\"_11av8sw0\" translations=\"[object Object]\"><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\"><span class=\"hxnnnr0\">Spotify</span></p></div></li><li class=\"_11av8sw0\" translations=\"[object Object]\"><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\"><span class=\"hxnnnr0\">Uber</span></p></div></li><li class=\"_11av8sw0\" translations=\"[object Object]\"><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\"><span class=\"hxnnnr0\">Netflix</span></p></div></li></ul></div><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\"><span class=\"hxnnnr0\">Pagas o entregas datos a cambio de acceso, pero </span><span class=\"hxnnnr0\"><strong>nada de eso es tuyo</strong></span><span class=\"hxnnnr0\">.</span></p></div><div class=\"_7pt7ks0\"><div class=\"_7pt7ks1\"></div></div><div id=\"el-verdadero-modelo-de-la-web-2\" class=\"hynlcx0\"><h2 class=\"hynlcx1 hynlcx3\" translations=\"[object Object]\"><span class=\"hxnnnr0\">El verdadero modelo de la Web2</span></h2></div><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\"><span class=\"hxnnnr0\">Resumido de forma simple:</span></p></div><div class=\"dream-post-content-bulletList _1ao94nj0\"><ul translations=\"[object Object]\" class=\"_1ao94nj1\"><li class=\"_11av8sw0\" translations=\"[object Object]\"><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\"><span class=\"hxnnnr0\">📦 Tú entregas datos</span></p></div></li><li class=\"_11av8sw0\" translations=\"[object Object]\"><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\"><span class=\"dl6s8g0 hxnnnr0\">🏢</span><span class=\"hxnnnr0\"> Las plataformas los almacenan</span></p></div></li><li class=\"_11av8sw0\" translations=\"[object Object]\"><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\"><span class=\"hxnnnr0\">💰 Las plataformas monetizan</span></p></div></li><li class=\"_11av8sw0\" translations=\"[object Object]\"><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\"><span class=\"hxnnnr0\">🔒 Las plataformas controlan</span></p></div></li></ul></div><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\"><span class=\"hxnnnr0\">Esto no es “bueno” o “malo” en sí.</span><br><span class=\"hxnnnr0\">Es simplemente </span><span class=\"hxnnnr0\"><strong>el modelo actual de Internet</strong></span><span class=\"hxnnnr0\">.</span></p></div><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\"><span class=\"hxnnnr0\">Y entender esto es clave para comprender </span><span class=\"hxnnnr0\"><strong>por qué surge Web3</strong></span><span class=\"hxnnnr0\">.</span></p></div><div class=\"_7pt7ks0\"><div class=\"_7pt7ks1\"></div></div><div id=\"mitos-y-errores-comunes\" class=\"hynlcx0\"><h2 class=\"hynlcx1 hynlcx3\" translations=\"[object Object]\"><span class=\"hxnnnr0\">Mitos y errores comunes</span></h2></div><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\"><span class=\"dl6s8g0 hxnnnr0\">❌</span><span class=\"hxnnnr0\"><strong> “Internet es libre y descentralizado”</strong></span><br><span class=\"hxnnnr0\">No del todo. La infraestructura crítica está altamente centralizada.</span></p></div><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\"><span class=\"dl6s8g0 hxnnnr0\">❌</span><span class=\"hxnnnr0\"><strong> “Mis datos son míos porque los subí yo”</strong></span><br><span class=\"hxnnnr0\">En la mayoría de los casos, los términos dicen lo contrario.</span></p></div><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\"><span class=\"dl6s8g0 hxnnnr0\">❌</span><span class=\"hxnnnr0\"><strong> “Web3 viene a reemplazar todo”</strong></span><br><span class=\"hxnnnr0\">No. Web3 nace como una </span><span class=\"hxnnnr0\"><strong>alternativa</strong></span><span class=\"hxnnnr0\">, no como un botón de apagado.</span></p></div><div class=\"_7pt7ks0\"><div class=\"_7pt7ks1\"></div></div><div id=\"3-ideas-clave\" class=\"hynlcx0\"><h2 class=\"hynlcx1 hynlcx3\" translations=\"[object Object]\"><span class=\"hxnnnr0\">3 Ideas clave</span></h2></div><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\"><span class=\"hxnnnr0\">1️⃣ La Web1 permitía leer, pero no interactuar</span><br><span class=\"hxnnnr0\">2️⃣ La Web2 permite interactuar, pero sin control real</span><br><span class=\"hxnnnr0\">3️⃣ Hoy dependemos de plataformas que concentran datos y poder</span></p></div><div class=\"_7pt7ks0\"><div class=\"_7pt7ks1\"></div></div><div id=\"preparando-el-terreno-para-web-3\" class=\"hynlcx0\"><h2 class=\"hynlcx1 hynlcx3\" translations=\"[object Object]\"><span class=\"hxnnnr0\">Preparando el terreno para Web3</span></h2></div><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\"><span class=\"hxnnnr0\">Antes de hablar de blockchain, wallets o criptomonedas, era necesario entender </span><span class=\"hxnnnr0\"><strong>qué problema intenta resolver Web3</strong></span><span class=\"hxnnnr0\">.</span></p></div><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\"><span class=\"hxnnnr0\">En el próximo artículo de la serie </span><span class=\"hxnnnr0\"><strong>“De 0 a Web3”</strong></span><span class=\"hxnnnr0\">, daremos el siguiente paso:</span><br><span class=\"hxnnnr0\">👉 </span><span class=\"hxnnnr0\"><strong>qué significa realmente “Web3” y por qué no es solo cripto.</strong></span></p></div><div data-generic-embed-container=\"true\" class=\"_8dv9ja0\"><a href=\"https://discord.gg/2SHteza5dJ\" target=\"_blank\"><div class=\"_8dv9ja2\"