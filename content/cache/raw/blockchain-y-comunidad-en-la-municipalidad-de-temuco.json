{"meta":{"id":"d5680bfb-3e9b-4d99-9565-2b63c485e630","publication_id":"30c7e4c1-15ed-46d8-a23d-32c90e011794","web_title":"Blockchain y comunidad en la Municipalidad de Temuco","parameterized_web_title":"blockchain-y-comunidad-en-la-municipalidad-de-temuco","utm_params_enabled":true,"utm_campaign":"blockchain-y-comunidad-en-la-municipalidad-de-temuco","utm_medium":"referral","utm_source":"blog.telluscoop.com","web_subtitle":"En enero, la Municipalidad de Temuco fue sede de un encuentro junto a Stellar donde comunidad, tecnología blockchain y colaboración se unieron en un espacio abierto y cercano.","web_audiences":"free","status":"published","active":true,"featured":false,"override_scheduled_at":"2026-02-05T13:42:40.905Z","slug":"blockchain-y-comunidad-en-la-municipalidad-de-temuco","is_premium":false,"image_url":"https://beehiiv-images-production.s3.amazonaws.com/uploads/asset/file/9f8cf764-09dd-40c9-b10c-4d5d80f56031/Captura_de_pantalla_2026-02-05_a_la_s__10.37.07_a.m..png?t=1770298930","image_width":1901,"image_height":1051,"meta_default_title":"Blockchain y comunidad en la Municipalidad de Temuco","meta_default_description":"En enero, la Municipalidad de Temuco fue sede de un encuentro junto a Stellar donde comunidad, tecnología blockchain y colaboración se unieron en un espacio abierto y cercano.","meta_og_title":"Blockchain y comunidad en la Municipalidad de Temuco","meta_og_description":"En enero, la Municipalidad de Temuco fue sede de un encuentro junto a Stellar donde comunidad, tecnología blockchain y colaboración se unieron en un espacio abierto y cercano.","meta_twitter_title":"Blockchain y comunidad en la Municipalidad de Temuco","meta_twitter_description":"En enero, la Municipalidad de Temuco fue sede de un encuentro junto a Stellar donde comunidad, tecnología blockchain y colaboración se unieron en un espacio abierto y cercano.","audience":"free","comments_enabled":true,"comments_state":"default","enforce_gated_content":false,"enable_popup_on_scroll":true,"email_capture_title":"Enjoying this post?","email_capture_message":"Subscribe to get more content like this delivered to your inbox for free!","email_capture_cta":"Subscribe","estimated_reading_time":3,"estimated_reading_time_display":"3 minutos","paywall_id":null,"authors":[{"id":"f296a348-b27c-4e82-ae84-fce2e49bff12","name":"Pau Koh","profile_picture":{"url":"https://beehiiv-images-production.s3.amazonaws.com/uploads/user/profile_picture/f296a348-b27c-4e82-ae84-fce2e49bff12/pau_headshot_1.png","thumb":{"url":"https://beehiiv-images-production.s3.amazonaws.com/uploads/user/profile_picture/f296a348-b27c-4e82-ae84-fce2e49bff12/thumb_pau_headshot_1.png"},"landscape":{"url":"https://beehiiv-images-production.s3.amazonaws.com/uploads/user/profile_picture/f296a348-b27c-4e82-ae84-fce2e49bff12/landscape_pau_headshot_1.png"}},"bio":"𝘊𝘔𝘎𝘙/𝘛𝘦𝘭𝘭𝘶𝘴 𝘊𝘰𝘰𝘱𝘦𝘳𝘢𝘵𝘪𝘷𝘦","twitter_handle":"kl0ren","facebook_url":null,"instagram_url":null,"linkedin_url":null,"tiktok_url":null,"youtube_url":null,"discord_url":null,"bluesky_url":null}],"content_tags":[{"id":"58f0d587-3f53-4436-bedc-0f2e915190a0","display":"Blockchain","slug":"blockchain"}],"created_at":"2026-02-05T13:25:24Z","updated_at":"2026-02-05T13:42:41Z","html":null,"hide_premium_post":false,"contains_subscriber_break":false,"is_accessible_for_free":true,"paywall_shown":false,"metered_usage_shown":false,"metered_viewed_count":null,"force_premium":false,"enforce_paywall_breaks":true,"display_thumbnail_on_web":false,"display_title_on_web":true,"display_subtitle_on_web":true,"author_urls":{"f296a348-b27c-4e82-ae84-fce2e49bff12":"https://blog.telluscoop.com/authors/pau-koh"},"custom_structured_data":null},"body":"<div class=\"_10pdwo80 dream-post-content-doc\"><div id=\"blockchain-y-comunidad-en-la-munici\" class=\"hynlcx0\"><h3 class=\"hynlcx1 hynlcx4\" translations=\"[object Object]\"><span class=\"hxnnnr0\">Blockchain y comunidad en la Municipalidad de Temuco</span></h3></div><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\"><span class=\"hxnnnr0\">Los días </span><span class=\"hxnnnr0\"><strong>10 y 11 de enero</strong></span><span class=\"hxnnnr0\">, la </span><span class=\"hxnnnr0\"><strong>Municipalidad de Temuco</strong></span><span class=\"hxnnnr0\"> fue el escenario de un encuentro que combinó tecnología, comunidad y conversación abierta. Junto a </span><span class=\"hxnnnr0\"><strong>Stellar</strong></span><span class=\"hxnnnr0\">, realizamos un </span><span class=\"hxnnnr0\"><strong>coffee break enfocado en blockchain</strong></span><span class=\"hxnnnr0\">, pensado para acercar esta tecnología a la comunidad local en un formato accesible, cercano y colaborativo.</span></p></div><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\"><span class=\"hxnnnr0\">Durante ambas jornadas, el espacio se transformó en un punto de encuentro para personas interesadas en aprender, conectar y compartir ideas sobre cómo blockchain puede generar impacto real en contextos locales.</span></p></div><div class=\"p-4\"><div class=\"mx-auto\" style=\"max-width:520px\"><div class=\"relative w-full h-0\" style=\"padding-bottom:56.25%\"><iframe class=\"absolute top-0 left-0\" width=\"100%\" height=\"100%\" src=\"https://youtube.com/embed/rD7AS1u_yoI\" allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture\" title=\"Youtube embed\"></iframe></div></div></div><div id=\"un-espacio-abierto-para-aprender-y-\" class=\"hynlcx0\"><h3 class=\"hynlcx1 hynlcx4\" translations=\"[object Object]\"><span class=\"hxnnnr0\">Un espacio abierto para aprender y conversar</span></h3></div><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\"><span class=\"hxnnnr0\">El objetivo del encuentro fue claro: </span><span class=\"hxnnnr0\"><strong>acercar la tecnología blockchain a las personas</strong></span><span class=\"hxnnnr0\">, sin barreras técnicas ni discursos lejanos. A través de conversaciones relajadas y ejemplos concretos, los asistentes pudieron:</span></p></div><div class=\"dream-post-content-bulletList _1ao94nj0\"><ul translations=\"[object Object]\" class=\"_1ao94nj1\"><li class=\"_11av8sw0\" translations=\"[object Object]\"><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\"><span class=\"hxnnnr0\">Comprender los fundamentos de blockchain</span></p></div></li><li class=\"_11av8sw0\" translations=\"[object Object]\"><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\"><span class=\"hxnnnr0\">Conocer cómo funciona la red </span><span class=\"hxnnnr0\"><strong>Stellar</strong></span><span class=\"hxnnnr0\"> y sus casos de uso reales</span></p></div></li><li class=\"_11av8sw0\" translations=\"[object Object]\"><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\"><span class=\"hxnnnr0\">Explorar el potencial de esta tecnología para proyectos locales</span></p></div></li><li class=\"_11av8sw0\" translations=\"[object Object]\"><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\"><span class=\"hxnnnr0\">Conectar con otras personas interesadas en innovación y tecnología</span></p></div></li></ul></div><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\"><span class=\"hxnnnr0\">Todo esto acompañado de café y un ambiente que invitó al diálogo y al intercambio de ideas.</span></p></div><div class=\"dream-post-content-imageBlock _2fealp0\" style=\"--caption-alignment:center\"><div class=\"_2fealp1\"><picture><source media=\"(max-width: 360px) and (min-resolution: 2dppx)\" srcset=\"https://media.beehiiv.com/cdn-cgi/image/fit=scale-down,quality=80,format=auto,width=720,onerror=redirect/uploads/asset/file/8bf74552-4242-4443-b5b8-1f91b0d93275/Captura_de_pantalla_2026-02-05_a_la_s__10.35.59_a.m..png?t=1770298566 2x\"><source media=\"(max-width: 360px)\" srcset=\"https://media.beehiiv.com/cdn-cgi/image/fit=scale-down,quality=80,format=auto,width=360,onerror=redirect/uploads/asset/file/8bf74552-4242-4443-b5b8-1f91b0d93275/Captura_de_pantalla_2026-02-05_a_la_s__10.35.59_a.m..png?t=1770298566 1x\"><source media=\"(max-width: 430px) and (min-resolution: 2dppx)\" srcset=\"https://media.beehiiv.com/cdn-cgi/image/fit=scale-down,quality=80,format=auto,width=860,onerror=redirect/uploads/asset/file/8bf74552-4242-4443-b5b8-1f91b0d93275/Captura_de_pantalla_2026-02-05_a_la_s__10.35.59_a.m..png?t=1770298566 2x\"><source media=\"(max-width: 430px)\" srcset=\"https://media.beehiiv.com/cdn-cgi/image/fit=scale-down,quality=80,format=auto,width=430,onerror=redirect/uploads/asset/file/8bf74552-4242-4443-b5b8-1f91b0d93275/Captura_de_pantalla_2026-02-05_a_la_s__10.35.59_a.m..png?t=1770298566 1x\"><img src=\"https://media.beehiiv.com/cdn-cgi/image/fit=scale-down,quality=80,format=auto,onerror=redirect/uploads/asset/file/8bf74552-4242-4443-b5b8-1f91b0d93275/Captura_de_pantalla_2026-02-05_a_la_s__10.35.59_a.m..png?t=1770298566\" alt=\"\" width=\"1550\" height=\"1146\" style=\"width:100%;border-radius:0px;aspect-ratio:1550 / 1146;height:auto\" class=\"_2fealp2 _2fealp5\"></picture></div></div><div id=\"trabajo-conjunto-con-la-municipalid\" class=\"hynlcx0\"><h3 class=\"hynlcx1 hynlcx4\" translations=\"[object Object]\"><span class=\"hxnnnr0\">Trabajo conjunto con la Municipalidad de Temuco</span></h3></div><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\"><span class=\"hxnnnr0\">La realización de este encuentro junto a la </span><span class=\"hxnnnr0\"><strong>Municipalidad de Temuco</strong></span><span class=\"hxnnnr0\"> refleja un interés compartido por </span><span class=\"hxnnnr0\"><strong>explorar nuevas herramientas tecnológicas</strong></span><span class=\"hxnnnr0\"> y fomentar espacios de aprendizaje e innovación abiertos a la comunidad.</span></p></div><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\"><span class=\"hxnnnr0\">La colaboración entre el sector público y el ecosistema tecnológico es clave para avanzar hacia soluciones más </span><span class=\"hxnnnr0\"><strong>transparentes, accesibles y eficientes</strong></span><span class=\"hxnnnr0\">, y este coffee break fue una muestra concreta de ese trabajo conjunto.</span></p></div><div class=\"dream-post-content-imageBlock _2fealp0\" style=\"--caption-alignment:center\"><div class=\"_2fealp1\"><picture><source media=\"(max-width: 360px) and (min-resolution: 2dppx)\" srcset=\"https://media.beehiiv.com/cdn-cgi/image/fit=scale-down,quality=80,format=auto,width=720,onerror=redirect/uploads/asset/file/ed1ec7e4-77de-42dd-a33e-9505eedbd0b0/Captura_de_pantalla_2026-02-05_a_la_s__10.32.46_a.m..png?t=1770298378 2x\"><source media=\"(max-width: 360px)\" srcset=\"https://media.beehiiv.com/cdn-cgi/image/fit=scale-down,quality=80,format=auto,width=360,onerror=redirect/uploads/asset/file/ed1ec7e4-77de-42dd-a33e-9505eedbd0b0/Captura_de_pantalla_2026-02-05_a_la_s__10.32.46_a.m..png?t=1770298378 1x\"><source media=\"(max-width: 430px) and (min-resolution: 2dppx)\" srcset=\"https://media.beehiiv.com/cdn-cgi/image/fit=scale-down,quality=80,format=auto,width=860,onerror=redirect/uploads/asset/file/ed1ec7e4-77de-42dd-a33e-9505eedbd0b0/Captura_de_pantalla_2026-02-05_a_la_s__10.32.46_a.m..png?t=1770298378 2x\"><source media=\"(max-width: 430px)\" srcset=\"https://media.beehiiv.com/cdn-cgi/image/fit=scale-down,quality=80,format=auto,width=430,onerror=redirect/uploads/asset/file/ed1ec7e4-77de-42dd-a33e-9505eedbd0b0/Captura_de_pantalla_2026-02-05_a_la_s__10.32.46_a.m..png?t=1770298378 1x\"><img src=\"https://media.beehiiv.com/cdn-cgi/image/fit=scale-down,quality=80,format=auto,onerror=redirect/uploads/asset/file/ed1ec7e4-77de-42dd-a33e-9505eedbd0b0/Captura_de_pantalla_2026-02-05_a_la_s__10.32.46_a.m..png?t=1770298378\" alt=\"\" loading=\"lazy\" width=\"1529\" height=\"1084\" style=\"width:100%;border-radius:0px;aspect-ratio:1529 / 1084;height:auto\" class=\"_2fealp2 _2fealp5\"></picture></div></div><div id=\"stellar-como-infraestructura-para-s\" class=\"hynlcx0\"><h3 class=\"hynlcx1 hynlcx4\" translations=\"[object Object]\"><span class=\"hxnnnr0\">Stellar como infraestructura para soluciones reales</span></h3></div><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\"><span class=\"hxnnnr0\">Uno de los ejes centrales del encuentro fue la red </span><span class=\"hxnnnr0\"><strong>Stellar</strong></span><span class=\"hxnnnr0\">, destacando su enfoque en:</span></p></div><div class=\"dream-post-content-bulletList _1ao94nj0\"><ul translations=\"[object Object]\" class=\"_1ao94nj1\"><li class=\"_11av8sw0\" translations=\"[object Object]\"><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\"><span class=\"hxnnnr0\">Accesibilidad financiera</span></p></div></li><li class=\"_11av8sw0\" translations=\"[object Object]\"><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\"><span class=\"hxnnnr0\">Pagos rápidos y de bajo costo</span></p></div></li><li class=\"_11av8sw0\" translations=\"[object Object]\"><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\"><span class=\"hxnnnr0\">Infraestructura abierta y escalable</span></p></div></li><li class=\"_11av8sw0\" translations=\"[object Object]\"><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\"><span class=\"hxnnnr0\">Casos de uso con impacto social y comunitario</span></p></div></li></ul></div><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\"><span class=\"hxnnnr0\">Más que hablar de tecnología futura, se conversó sobre </span><span class=\"hxnnnr0\"><strong>soluciones que ya existen</strong></span><span class=\"hxnnnr0\"> y que pueden ser adaptadas a distintos contextos locales.</span></p></div><div id=\"comunidad-primero\" class=\"hynlcx0\"><h3 class=\"hynlcx1 hynlcx4\" translations=\"[object Object]\"><span class=\"hxnnnr0\">Comunidad primero</span></h3></div><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\"><span class=\"hxnnnr0\">Ver a personas de distintos perfiles —estudiantes, profesionales, emprendedores y entusiastas— compartiendo preguntas, experiencias y perspectivas confirmó algo fundamental: </span><span class=\"hxnnnr0\"><strong>la comunidad es el motor de la innovación</strong></span><span class=\"hxnnnr0\">.</span></p></div><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\"><span class=\"hxnnnr0\">Este encuentro en la Municipalidad de Temuco refuerza el compromiso de seguir creando espacios donde la tecnología se explique de forma clara, se discuta de manera abierta y se construya de forma colaborativa.</span></p></div><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\"><span class=\"hxnnnr0\">Seguimos avanzando para que </span><span class=\"hxnnnr0\"><strong>blockchain sea una herramienta al servicio de las personas y las comunidades</strong></span><span class=\"hxnnnr0\">.</span></p></div><div class=\"dream-post-content-imageBlock _2fealp0\" style=\"--caption-alignment:center\"><div class=\"_2fealp1\"><picture><source media=\"(max-width: 360px) and (min-resolution: 2dppx)\" srcset=\"https://media.beehiiv.com/cdn-cgi/image/fit=scale-down,quality=80,format=auto,width=720,onerror=redirect/uploads/asset/file/b7606eb0-199f-4765-ac23-4fdfaadfe8a8/Captura_de_pantalla_2026-02-05_a_la_s__10.34.00_a.m..png?t=1770298449 2x\"><source media=\"(max-width: 360px)\" srcset=\"https://media.beehiiv.com/cdn-cgi/image/fit=scale-down,quality=80,format=auto,width=360,onerror=redirect/uploads/asset/file/b7606eb0-199f-4765-ac23-4fdfaadfe8a8/Captura_de_pantalla_2026-02-05_a_la_s__10.34.00_a.m..png?t=1770298449 1x\"><source media=\"(max-width: 430px) and (min-resolution: 2dppx)\" srcset=\"https://media.beehiiv.com/cdn-cgi/image/fit=scale-down,quality=80,format=auto,width=860,onerror=redirect/uploads/asset/file/b7606eb0-199f-4765-ac23-4fdfaadfe8a8/Captura_de_pantalla_2026-02-05_a_la_s__10.34.00_a.m..png?t=1770298449 2x\"><source media=\"(max-width: 430px)\" srcset=\"https://media.beehiiv.com/cdn-cgi/image/fit=scale-down,quality=80,format=auto,width=430,onerror=redirect/uploads/asset/file/b7606eb0-199f-4765-ac23-4fdfaadfe8a8/Captura_de_pantalla_2026-02-05_a_la_s__10.34.00_a.m..png?t=1770298449 1x\"><img src=\"https://media.beehiiv.com/cdn-cgi/image/fit=scale-down,quality=80,format=auto,onerror=redirect/uploads/asset/file/b7606eb0-199f-4765-ac23-4fdfaadfe8a8/Captura_de_pantalla_2026-02-05_a_la_s__10.34.00_a.m..png?t=1770298449\" alt=\"\" loading=\"lazy\" width=\"1524\" height=\"1107\" style=\"width:100%;border-radius:0px;aspect-ratio:1524 / 1107;height:auto\" class=\"_2fealp2 _2fealp5\"></picture></div></div><div class=\"j6zgbu0\"><p class=\"dream-post-content-paragraph j6zgbu1\"></p></div></div>","publication":{"name":"Tellus Cooperative","description":"La Cooperativa Blockchain de LatAm","url":"https://blog.telluscoop.com/","twitter_url":"https://x.com/telluscoop","instagram_url":"https://instagram.com/telluscoop","linkedin_url":"https://linkedin.com/company/Tellus-Cooperative","youtube_url":"https://youtube.com/@telluscoop","discord_url":"https://discord.gg/V4eSGWA3PK"}}